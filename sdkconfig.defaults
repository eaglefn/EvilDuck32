# EvilDuck32 SDK Configuration Defaults
# Target: ESP32-S3 (Waveshare ESP32-S3 LCD 1.47)

# CPU
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# PSRAM (Octal, 8MB)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# USB OTG (required for TinyUSB device mode on ESP32-S3)
CONFIG_USB_OTG_SUPPORTED=y

# Bluetooth
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# LVGL - Fonts (enable multiple sizes for better readability)
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_DEFAULT&CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_12=&CONFIG_LV_FONT_MONTSERRAT_14
CONFIG_LV_FONT_MONTSERRAT_16=&CONFIG_LV_FONT_MONTSERRAT_14
CONFIG_LV_USE_USER_DATA=y
# CONFIG_LV_USE_PERF_MONITOR is not set

# WiFi
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# FAT filesystem - Long File Names (needed for lowercase/mixed-case filenames on SD card)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
# API encoding: UTF-8 für korrekte Umlaute/Sonderzeichen in Dateinamen
CONFIG_FATFS_API_ENCODING_UTF_8=y

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
